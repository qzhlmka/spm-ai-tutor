{
  "name": "spm-ai-tutor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc && npm --prefix frontend ci && npm --prefix frontend run build",
    "start": "node dist/server.js",
    "ingest": "tsx src/ingest/ingest.ts",
    "reembed": "tsx src/scripts/reembed.ts",
    "router:graph": "tsx src/scripts/router-graph.ts",
    "golden:draft": "tsx --env-file=.env src/scripts/golden-draft.ts",
    "golden:check": "tsx src/scripts/golden-check.ts",
    "golden:upload": "tsx --env-file=.env src/scripts/golden-upload.ts",
    "typecheck": "tsc --noEmit",
    "build:api": "tsc"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/static": "^8.3.0",
    "@huggingface/transformers": "^4.2.0",
    "@langchain/core": "^1.2.17",
    "@langchain/langgraph": "^1.4.20",
    "@langfuse/client": "^5.13.0",
    "@langfuse/otel": "^5.13.0",
    "@langfuse/tracing": "^5.13.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/sdk-trace-node": "^2.11.0",
    "@supabase/supabase-js": "^2.45.4",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "openai": "^4.68.4",
    "pdf-parse": "^1.1.1",
    "sharp": "^0.34.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdf-parse": "^1.1.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "onnxruntime-node": "1.23.0"
  }
}
