SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PORT=3000

# --- Optional: extra LLM providers for the tutoring answer (src/lib/providers.ts) ---
# Only the main tutoring answer follows the student's choice. The teacher-material
# relevance gate and the visual-diagram decision always run on Anthropic.
#
# IlmuChat is OpenAI-compatible, so all three of these are needed together — the
# provider is hidden from the picker entirely until they are all set.
#
# ILMU is YTL AI Labs' Malaysian model (docs.ilmu.ai). The base URL and model id
# below are public and already filled in; only the key is yours to supply, from
# console.ilmu.ai/dashboard/keys — it is shown ONCE at creation and cannot be
# retrieved afterwards. ilmu-v3.1 is the flagship (200k context, vision); the
# cheaper ilmu-mini-v3.3 and the plan-gated nemo-* models are the alternatives.
ILMUCHAT_BASE_URL=https://api.ilmu.ai/v1
ILMUCHAT_API_KEY=
ILMUCHAT_MODEL=ilmu-v3.1

# Which OpenAI model answers when a user picks GPT. Defaults to gpt-5.6-terra.
OPENAI_TUTOR_MODEL=

# Per-1M-token prices. A provider WITHOUT these is offered to teachers only:
# costUsd() returns 0 for a model it has no rate for, a 0 cost never moves
# usage_daily, and a student whose turns cost nothing never hits the daily cap —
# an unpriced provider open to students is an uncapped spend path that looks
# exactly like a working one. Teachers are exempt from the cap anyway.
OPENAI_PRICE_INPUT_PER_1M=
OPENAI_PRICE_OUTPUT_PER_1M=

# Students' daily spend cap in USD. Blank = no cap. Spend is recorded either way.
# (Was a fixed 0.20 until 2026-10-16.)
STUDENT_DAILY_BUDGET_USD=
#
# ILMU PUBLISHES IN RINGGIT, THESE VARS ARE USD. ilmu-v3.1 is RM 4.00 / RM 16.00
# per 1M — pasting those figures in as-is prices it at roughly 4x its real cost
# and fires the student cap about four times too early, which looks like a
# working config while quietly rationing students. Divide by the current MYR/USD
# rate first. This is also why ILMU is not in KNOWN_MODEL_PRICING: that table
# holds published rates, and an FX conversion is an assumption with a shelf life.
ILMUCHAT_PRICE_INPUT_PER_1M=
ILMUCHAT_PRICE_OUTPUT_PER_1M=

# Langfuse tracing (optional; off unless both keys are set). EU cloud by default;
# US: https://us.cloud.langfuse.com, or your self-hosted URL.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
